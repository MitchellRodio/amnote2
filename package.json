{
  "name": "creator-tasks-slack-app",
  "version": "0.2.0",
  "private": true,
  "description": "Slack-native task manager for account managers handling creator channels.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@slack/bolt": "^4.2.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
