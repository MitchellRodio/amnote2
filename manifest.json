{
  "display_information": {
    "name": "Creator Tasks",
    "description": "Slack-native creator task tracking for account managers",
    "background_color": "#111827"
  },
  "features": {
    "bot_user": {
      "display_name": "Creator Tasks",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/todo",
        "description": "Create a task in the current creator channel",
        "usage_hint": "/todo Update statement descriptor",
        "should_escape": false
      },
      {
        "command": "/todos",
        "description": "Show open tasks for the current creator channel",
        "usage_hint": "/todos",
        "should_escape": false
      },
      {
        "command": "/mytodos",
        "description": "Show my open tasks",
        "usage_hint": "/mytodos",
        "should_escape": false
      },
      {
        "command": "/list",
        "description": "Show my open tasks in a DM with the bot",
        "usage_hint": "/list",
        "should_escape": false
      },
      {
        "command": "/link",
        "description": "Link the current creator channel to a HubSpot company",
        "usage_hint": "/link ToolSuite or /link 123456",
        "should_escape": false
      }
    ],
    "shortcuts": [
      {
        "name": "Create Task",
        "type": "message",
        "callback_id": "create_task_from_message",
        "description": "Turn this message into a tracked task"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "chat:write.public",
        "commands",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "mpim:history",
        "mpim:read",
        "reactions:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "reaction_added"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}